#include <winres.h>
#include "resource.h"

IDI_APP ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "3DS VR"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductName", "3DS VR"
            VALUE "ProductVersion", "1.0.0"
            VALUE "OriginalFilename", "3DS VR.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
