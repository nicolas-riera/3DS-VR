# cmake -DDLL=... -DINF=... -DOUT=... -P hashes.cmake
# The app only signs the gamepad package it was built with: it checks these
# hashes before signing.
file(SHA256 "${DLL}" dll_hash)
file(SHA256 "${INF}" inf_hash)
file(WRITE "${OUT}.tmp" "// generated by gamepad_driver/hashes.cmake\n#define PAD_DLL_SHA256 \"${dll_hash}\"\n#define PAD_INF_SHA256 \"${inf_hash}\"\n")
configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
file(REMOVE "${OUT}.tmp")
